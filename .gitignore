# the real .git folder lives in .git.nosync so iCloud does not sync it
.git.nosync/

# build output (and iCloud's conflict copies of it, e.g. "dist 2")
/dist/
/dist *
/dist.building/
/dist.nosync/
/dist.building.nosync/
/build-cache.nosync/

# Python / macOS
__pycache__/
*.pyc
.DS_Store

# local notes (they describe the retired local app and hold local paths)
/docs/
